# /etc/systemd/system/fileserver.service 
# 
# after changing this file, run ./reload.sh

[Unit]
Description=File Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/src/quantz-web/fileserver
ExecStart=/usr/bin/go run fileserver.go
User=kaz
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target