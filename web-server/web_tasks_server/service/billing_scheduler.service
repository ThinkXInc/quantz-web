[Unit]
Description=Celery Worker for Billing Scheduler Tasks
After=network.target

[Service]
Type=simple
User=kaz
Environment="WORKER_TYPE=billing"
WorkingDirectory=/src/quantz-web/web-server
ExecStart=/src/quantz-web/web-server/venv/bin/celery -A web_tasks_server.run:celery_app worker -l warning --concurrency=1 -Q billing.echo,billing.run_payment --hostname=billing_worker_1
Restart=on-failure

[Install]
WantedBy=multi-user.target