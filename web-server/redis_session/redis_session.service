[Unit]
Description=Redis service for NeuraVoice Control Center Session
After=network.target

[Service]
Type=simple
WorkingDirectory=/src/quantz-web/web-server
ExecStart=/usr/bin/redis-server /src/quantz-web/web-server/redis_session/redis_session.conf
User=kaz
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target